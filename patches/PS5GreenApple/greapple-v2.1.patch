diff --git a/src/nexus_boot.c b/src/nexus_boot.c
new file mode 100644
index 0000000..a774e08
--- /dev/null
+++ b/src/nexus_boot.c
@@ -0,0 +1,523 @@
+/* nexus_boot.c - one tiny JSON emitter + reader for the NEXUS boot intent.
+ *
+ * No dependencies, fixed schema, atomic rename. Embedded strings only
+ * (same style as the repo's embedded Liberation fonts); no dynamic
+ * allocation beyond stdio buffers. See nexus_boot.h for the contract.
+ */
+#include "nexus_boot.h"
+#include "common.h"          /* psa_snprintf / psa_strcpy / file_exists (core.c) */
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <stdarg.h>
+#include <time.h>
+#include <sys/stat.h>
+#include <errno.h>
+
+#ifdef _WIN32
+#include <direct.h>
+#include <io.h>
+#define N_MKDIR(p)    _mkdir(p)
+#define N_FSYNC(fh)   (_commit(_fileno(fh)) == 0)
+#else
+#include <unistd.h>
+#include <fcntl.h>
+#define N_MKDIR(p)    mkdir((p), 0755)
+#define N_FSYNC(fh)   (fsync(fileno(fh)) == 0)
+#endif
+
+/* ---------------------------------------------------------------- paths */
+
+const char *nexus_data_dir(void)
+{
+#ifdef __PS5__
+    return "/data";
+#else
+    const char *env = getenv("NEXUS_DATA_DIR");
+    return (env && env[0]) ? env : "./data";
+#endif
+}
+
+const char *nexus_preset_base(void)
+{
+#ifdef __PS5__
+    return "/mnt/usb0";
+#else
+    const char *env = getenv("NEXUS_PRESET_BASE");
+    return (env && env[0]) ? env : "./preset-fixture";
+#endif
+}
+
+static void path_append(char *out, size_t n, const char *a, const char *b)
+{
+    psa_snprintf(out, n, "%s/%s", a, b);
+}
+
+/* ------------------------------------------------------------ flavor table */
+
+/* Order matches the hub roster in app_nexus.c (top to bottom in the ice
+ * cream stack). Slugs match chainload-linux.sh exactly. */
+static const char *const S_flavors[] = {
+    "ubuntu", "fedora", "arch", "debian",
+    "cachyos", "nobara", "mint", "omarchy"
+};
+#define N_FLAVORS ((int)(sizeof(S_flavors) / sizeof(S_flavors[0])))
+
+int         nexus_flavor_count(void)            { return N_FLAVORS; }
+const char *nexus_flavor_slug(int idx)          { return (idx >= 0 && idx < N_FLAVORS) ? S_flavors[idx] : NULL; }
+
+int nexus_flavor_known(const char *slug)
+{
+    if (!slug || !slug[0]) return 0;
+    for (int i = 0; i < N_FLAVORS; i++)
+        if (!strcmp(slug, S_flavors[i])) return 1;
+    return 0;
+}
+
+int nexus_flavor_preset_present(const char *flavor)
+{
+    if (!nexus_flavor_known(flavor)) return 0;
+    char base[256], dir[512], kern[768];
+    psa_strcpy(base, sizeof(base), nexus_preset_base());
+    path_append(dir, sizeof(dir), base, "linux");
+    path_append(kern, sizeof(kern), dir, flavor);
+    path_append(dir, sizeof(dir), kern, "vmlinuz");
+    return file_exists(dir);   /* the same artifact chainload-linux.sh die()s on */
+}
+
+/* ------------------------------------------------------------------ time */
+
+/* Days from civil (Howard Hinnant's algorithm) - a portable timegm for the
+ * UTC "YYYY-MM-DD HH:MM:SS" stamps this module writes. */
+static long days_from_civil(long y, unsigned m, unsigned d)
+{
+    y -= m <= 2;
+    const long era = (y >= 0 ? y : y - 399) / 400;
+    const unsigned yoe = (unsigned)(y - era * 400);
+    const unsigned doy = (153u * (m + (m > 2 ? -3u : 9u)) + 2u) / 5u + d - 1u;
+    const unsigned doe = yoe * 365u + yoe / 4u - yoe / 100u + doy;
+    return era * 146097L + (long)doe - 719468L;
+}
+
+static void iso8601_utc(char *out, size_t n)
+{
+    time_t t = time(NULL);
+    struct tm tmu;
+#ifdef _WIN32
+    gmtime_s(&tmu, &t);
+#else
+    gmtime_r(&t, &tmu);
+#endif
+    strftime(out, n, "%Y-%m-%d %H:%M:%S", &tmu);
+}
+
+static long utc_epoch(const char *s)
+{
+    int Y = 0, M = 0, D = 0, h = 0, m = 0, sec = 0;
+    if (sscanf(s, "%d-%d-%d %d:%d:%d", &Y, &M, &D, &h, &m, &sec) != 6) return -1;
+    if (M < 1 || M > 12 || D < 1 || D > 31) return -1;
+    return days_from_civil(Y, (unsigned)M, (unsigned)D) * 86400L
+           + h * 3600L + m * 60L + sec;
+}
+
+/* -------------------------------------------------------------- the writer */
+
+static void set_err(char *errbuf, size_t errlen, const char *fmt, ...)
+{
+    if (!errbuf || errlen == 0) return;
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(errbuf, errlen, fmt, ap);
+    va_end(ap);
+}
+
+static int ensure_nexus_dir(const char *data_dir, char *errbuf, size_t errlen)
+{
+    char p[512];
+    N_MKDIR(data_dir);                       /* EEXIST is fine */
+    path_append(p, sizeof(p), data_dir, "NEXUS");
+    if (N_MKDIR(p) != 0 && errno != EEXIST) {
+        set_err(errbuf, errlen, "cannot create %s (%s)", p, strerror(errno));
+        return -1;
+    }
+    return 0;
+}
+
+int nexus_write_select(const char *data_dir,
+                       const char *target, const char *flavor,
+                       char *errbuf, size_t errlen)
+{
+    if (errbuf && errlen) errbuf[0] = '\0';
+    if (!data_dir || !data_dir[0]) { set_err(errbuf, errlen, "no data dir"); return -1; }
+
+    /* ---- validate BEFORE touching disk: the reader must never see an
+     * intent this writer already knew was bad (SM-01: validation happens
+     * before any exec, and a failed stage leaves the previous intent). ---- */
+    if (!target || !target[0]) { set_err(errbuf, errlen, "empty target"); return -1; }
+    int is_linux = !strcmp(target, "linux");
+    if (strcmp(target, "macos") && strcmp(target, "windows") && !is_linux) {
+        set_err(errbuf, errlen, "unknown target '%s' (macos|windows|linux)", target);
+        return -1;
+    }
+    if (is_linux) {
+        if (!flavor || !flavor[0]) {
+            set_err(errbuf, errlen, "target=linux needs a flavor");
+            return -1;
+        }
+        if (!nexus_flavor_known(flavor)) {
+            set_err(errbuf, errlen, "unknown flavor '%s'", flavor);
+            return -1;
+        }
+    } else if (flavor && flavor[0]) {
+        set_err(errbuf, errlen, "flavor only valid with target=linux");
+        return -1;
+    }
+
+    if (ensure_nexus_dir(data_dir, errbuf, errlen) != 0) return -1;
+
+    char dir[512], tmp[768], dst[768];
+    path_append(dir, sizeof(dir), data_dir, "NEXUS");
+    path_append(tmp, sizeof(tmp), dir, "boot-select.json.tmp");
+    path_append(dst, sizeof(dst), dir, "boot-select.json");
+
+    FILE *fh = fopen(tmp, "w");
+    if (!fh) {
+        set_err(errbuf, errlen, "cannot write %s (%s) - check /data writable",
+                tmp, strerror(errno));
+        return -1;
+    }
+    char stamp[32];
+    iso8601_utc(stamp, sizeof(stamp));
+    if (is_linux)
+        fprintf(fh, "{\"version\":%d,\"target\":\"%s\",\"flavor\":\"%s\","
+                    "\"staged_at\":\"%s\",\"staged_by\":\"%s\"}\n",
+                NEXUS_SELECT_VERSION, target, flavor, stamp, NEXUS_STAGED_BY);
+    else
+        fprintf(fh, "{\"version\":%d,\"target\":\"%s\","
+                    "\"staged_at\":\"%s\",\"staged_by\":\"%s\"}\n",
+                NEXUS_SELECT_VERSION, target, stamp, NEXUS_STAGED_BY);
+
+    /* flush + fsync BEFORE rename: after a crash the .tmp may survive, but
+     * the staged intent itself is never half-written. */
+    if (fflush(fh) != 0 || !N_FSYNC(fh)) {
+        set_err(errbuf, errlen, "flush failed for %s (%s)", tmp, strerror(errno));
+        fclose(fh);
+        remove(tmp);
+        return -1;
+    }
+    fclose(fh);
+
+    if (rename(tmp, dst) != 0) {
+        set_err(errbuf, errlen, "rename failed (%s) - check /data writable",
+                strerror(errno));
+        remove(tmp);
+        return -1;
+    }
+#ifndef _WIN32
+    /* best-effort directory fsync so the rename itself survives power loss */
+    int dfd = open(dir, O_RDONLY | O_DIRECTORY);
+    if (dfd >= 0) { fsync(dfd); close(dfd); }
+#endif
+    return 0;
+}
+
+/* -------------------------------------------------------------- the reader */
+
+/* Minimal extraction of "key":value from our fixed schema. Finds the key
+ * anywhere (writers may order keys); handles string values and bare
+ * numbers ("version":1). Returns 0 on success. */
+static int json_str_value(const char *json, const char *key,
+                          char *out, size_t outlen)
+{
+    char pat[48];
+    psa_snprintf(pat, sizeof(pat), "\"%s\"", key);
+    const char *k = strstr(json, pat);
+    if (!k) return -1;
+    k = strchr(k + strlen(pat), ':');
+    if (!k) return -1;
+    k++;
+    while (*k == ' ' || *k == '\t') k++;
+    if (*k == '"') {                         /* string value */
+        k++;
+        size_t n = 0;
+        while (*k && *k != '"') {
+            char c = *k++;
+            if (c == '\\' && *k) c = *k++;   /* no fancy escapes in our schema */
+            if (n + 1 < outlen) out[n++] = c;
+        }
+        out[n] = '\0';
+        return (*k == '"') ? 0 : -1;
+    }
+    if (*k == '-' || (*k >= '0' && *k <= '9')) {   /* bare number */
+        size_t n = 0;
+        while (*k && *k != ',' && *k != '}' && *k != ' ') {
+            if (n + 1 < outlen) out[n++] = *k;
+            k++;
+        }
+        out[n] = '\0';
+        return 0;
+    }
+    return -1;
+}
+
+int nexus_read_staged(const char *data_dir, NexusStaged *out,
+                      char *errbuf, size_t errlen)
+{
+    if (errbuf && errlen) errbuf[0] = '\0';
+    memset(out, 0, sizeof(*out));
+    char path[768], dir[512];
+    path_append(dir, sizeof(dir), data_dir ? data_dir : "", "NEXUS");
+    path_append(path, sizeof(path), dir, "boot-select.json");
+
+    FILE *fh = fopen(path, "r");
+    if (!fh) return 1;                       /* nothing staged - normal */
+    char json[1024];
+    size_t n = fread(json, 1, sizeof(json) - 1, fh);
+    fclose(fh);
+    json[n] = '\0';
+
+    out->present = 1;
+    char ver[16] = "";
+    if (json_str_value(json, "version", ver, sizeof(ver)) == 0)
+        out->version_ok = (atoi(ver) == NEXUS_SELECT_VERSION);
+    else
+        out->version_ok = 0;                 /* missing version = not ours */
+
+    if (json_str_value(json, "target", out->target, sizeof(out->target)) != 0) {
+        set_err(errbuf, errlen, "staged intent has no target field");
+        return -1;
+    }
+    json_str_value(json, "flavor", out->flavor, sizeof(out->flavor));
+    json_str_value(json, "staged_at", out->staged_at, sizeof(out->staged_at));
+
+    out->target_ok = !strcmp(out->target, "macos")
+                  || !strcmp(out->target, "windows")
+                  || !strcmp(out->target, "linux");
+    int is_linux = !strcmp(out->target, "linux");
+    out->flavor_ok = is_linux ? nexus_flavor_known(out->flavor)
+                              : (out->flavor[0] == '\0');
+
+    out->age_s = -1;
+    long ep = utc_epoch(out->staged_at);
+    if (ep >= 0) out->age_s = (long)time(NULL) - ep;
+    return 0;
+}
+
+int nexus_read_last_status(const char *data_dir, char *out, size_t outlen)
+{
+    if (outlen) out[0] = '\0';
+    char path[768], dir[512];
+    path_append(dir, sizeof(dir), data_dir ? data_dir : "", "NEXUS");
+    path_append(path, sizeof(path), dir, "boot-log.txt");
+
+    FILE *fh = fopen(path, "r");
+    if (!fh) return -1;
+
+    /* ring of the last 8 lines */
+    char ring[8][192];
+    int head = 0, count = 0;
+    char line[512];
+    while (fgets(line, sizeof(line), fh)) {
+        size_t l = strlen(line);
+        while (l && (line[l - 1] == '\n' || line[l - 1] == '\r')) line[--l] = '\0';
+        psa_strcpy(ring[head], sizeof(ring[head]), line);
+        head = (head + 1) % 8;
+        if (count < 8) count++;
+    }
+    fclose(fh);
+
+    size_t used = 0;
+    for (int i = 0; i < count; i++) {
+        const char *s = ring[(head - count + i + 16) % 8];
+        size_t sl = strlen(s);
+        if (used + sl + 2 >= outlen) break;
+        if (i) out[used++] = '\n';
+        memcpy(out + used, s, sl + 1);
+        used += sl;
+    }
+    return 0;
+}
+
+void nexus_status_summary(const char *data_dir, char *out, size_t outlen)
+{
+    NexusStaged st;
+    char err[128];
+    int rc = nexus_read_staged(data_dir, &st, err, sizeof(err));
+    if (rc == 1) { psa_strcpy(out, outlen, "no intent staged"); return; }
+    if (rc < 0)  { psa_snprintf(out, outlen, "unreadable intent: %s", err); return; }
+    if (!st.version_ok) {
+        psa_snprintf(out, outlen, "SCHEMA MISMATCH - staged intent is not version %d",
+                     NEXUS_SELECT_VERSION);
+        return;
+    }
+    if (!st.target_ok || !st.flavor_ok) {
+        psa_snprintf(out, outlen, "INVALID intent staged (target=%s flavor=%s)",
+                     st.target, st.flavor);
+        return;
+    }
+    if (st.flavor[0])
+        psa_snprintf(out, outlen, "target=%s flavor=%s age=%lds",
+                     st.target, st.flavor, st.age_s);
+    else
+        psa_snprintf(out, outlen, "target=%s age=%lds", st.target, st.age_s);
+}
+
+/* ------------------------------------------------ lsblk volume enumeration
+ * (greapple-v2 Patch 3 - SM-05 "Boot Camp Volume Row", DETECTED state) */
+
+/* lsblk raw mode escapes specials inside values as \xNN (space -> \x20).
+ * Decode in place so labels like "My\x20Disk" read naturally. */
+static void decode_escapes(char *s)
+{
+    char *w = s;
+    while (*s) {
+        if (s[0] == '\\' && s[1] == 'x' &&
+            ((s[2] >= '0' && s[2] <= '9') || (s[2] >= 'a' && s[2] <= 'f')) &&
+            ((s[3] >= '0' && s[3] <= '9') || (s[3] >= 'a' && s[3] <= 'f'))) {
+            char hex[3] = { s[2], s[3], 0 };
+            *w++ = (char)strtol(hex, NULL, 16);
+            s += 4;
+        } else {
+            *w++ = *s++;
+        }
+    }
+    *w = '\0';
+}
+
+static int looks_like_size(const char *s)
+{
+    if (!s || !(*s >= '0' && *s <= '9')) return 0;
+    int dots = 0;
+    for (; *s; s++) {
+        if (*s >= '0' && *s <= '9') continue;
+        if (*s == '.' && !dots) { dots = 1; continue; }
+        break;
+    }
+    if (!*s) return 0;                        /* bare number is not a size */
+    switch (*s) {                             /* optional binary unit */
+    case 'K': case 'M': case 'G': case 'T': case 'P': case 'E':
+        return s[1] == '\0';
+    case 'B':
+        return s[1] == '\0';
+    case 'i':                                 /* lsblk "KiB" style is rare; accept */
+        return s[1] == 'B' && s[2] == '\0';
+    default:
+        return 0;
+    }
+}
+
+int nexus_parse_lsblk_line(const char *line, VolumeInfo *out)
+{
+    memset(out, 0, sizeof(*out));
+    while (*line == ' ' || *line == '\t') line++;
+    if (!*line) return 0;
+
+    /* tokenize on whitespace runs (raw values carry no literal spaces) */
+    char toks[8][128];
+    int ntok = 0;
+    const char *p = line;
+    while (*p && ntok < 8) {
+        while (*p == ' ' || *p == '\t') p++;
+        if (!*p) break;
+        int i = 0;
+        while (*p && *p != ' ' && *p != '\t' && i < 127) toks[ntok][i++] = *p++;
+        toks[ntok][i] = '\0';
+        ntok++;
+    }
+    if (!ntok) return 0;
+
+    psa_strcpy(out->name, sizeof(out->name), toks[0]);
+    if (!strncmp(out->name, "nvme0n1", 7))    /* internal SSD + its parts */
+        out->internal_nvme = 1;
+
+    /* mountpoint: trailing token starting with '/' */
+    int core_end = ntok;
+    if (ntok >= 2 && toks[ntok - 1][0] == '/') {
+        psa_strcpy(out->mountpoint, sizeof(out->mountpoint), toks[ntok - 1]);
+        decode_escapes(out->mountpoint);
+        out->mounted = 1;
+        core_end = ntok - 1;
+    }
+
+    /* size: last remaining core token that looks like one */
+    int core_len = core_end - 1;              /* tokens after NAME */
+    if (core_len > 0 && looks_like_size(toks[core_end - 1])) {
+        psa_strcpy(out->size, sizeof(out->size), toks[core_end - 1]);
+        core_len--;
+        if (core_len > 0) {                   /* fstype, then optional label */
+            psa_strcpy(out->fstype, sizeof(out->fstype), toks[1]);
+            decode_escapes(out->fstype);
+            if (core_len > 1) {
+                psa_strcpy(out->label, sizeof(out->label), toks[2]);
+                decode_escapes(out->label);
+            }
+        }
+    }
+    return 1;
+}
+
+int nexus_lsblk_walk(bootcamp_volume_cb cb, void *user)
+{
+    FILE *f = popen("lsblk -rno NAME,FSTYPE,LABEL,SIZE,MOUNTPOINT 2>/dev/null", "r");
+    if (!f) return 0;                         /* no shell / no lsblk: 0 rows */
+    char line[512];
+    int count = 0;
+    VolumeInfo v;
+    while (fgets(line, sizeof(line), f)) {
+        size_t l = strlen(line);
+        while (l && (line[l - 1] == '\n' || line[l - 1] == '\r')) line[--l] = '\0';
+        if (nexus_parse_lsblk_line(line, &v)) {
+            count++;
+            if (cb) cb(&v, user);
+        }
+    }
+    pclose(f);
+    return count;
+}
+
+/* -------------------------------------------------- guarded stage (SM-01) */
+
+int nexus_stage_guarded(const char *target, const char *flavor,
+                        char *status, size_t statusn,
+                        char *detail, size_t detailn)
+{
+    if (status && statusn) status[0] = '\0';
+    if (detail && detailn) detail[0] = '\0';
+
+    /* Linux flavor with no PS5 kernel preset: the Linux stage would die on
+     * the missing artifact (chainload-linux.sh die "kernel not found").
+     * Say SIMULATED now and do not stage a doomed intent. */
+    if (flavor && flavor[0] && !nexus_flavor_preset_present(flavor)) {
+        psa_strcpy(status, statusn,
+                   "SIMULATED \xc2\xb7 this flavor has no PS5 kernel staged");
+        psa_snprintf(detail, detailn,
+                     "flavor %s: put its PS5-built kernel on the boot USB "
+                     "(<base>/linux/%s/vmlinuz) to make it stageable",
+                     flavor, flavor);
+        return 1;
+    }
+
+    char err[192];
+    if (nexus_write_select(nexus_data_dir(), target, flavor,
+                           err, sizeof(err)) != 0) {
+        psa_strcpy(status, statusn,
+                   "STAGE FAILED \xc2\xb7 check /data writable");
+        psa_strcpy(detail, detailn, err);
+        return -1;
+    }
+
+    psa_strcpy(status, statusn,
+               "STAGED \xc2\xb7 will boot on next Linux-stage run");
+    if (!strcmp(target, "macos"))
+        psa_strcpy(detail, detailn,
+                   "chain M \xc2\xb7 PROVEN upstream (FW 13.42, "
+                   "rodri0x/ps5-hackintosh) \xc2\xb7 stage1 on boot USB required");
+    else if (!strcmp(target, "windows"))
+        psa_strcpy(detail, detailn,
+                   "chain W \xc2\xb7 RESEARCH - no public Windows boot chain yet");
+    else
+        psa_snprintf(detail, detailn,
+                     "chain L \xc2\xb7 READY \xc2\xb7 flavor %s "
+                     "(kernel from the boot USB preset table)", flavor);
+    return 0;
+}
diff --git a/src/nexus_boot.h b/src/nexus_boot.h
new file mode 100644
index 0000000..87244f3
--- /dev/null
+++ b/src/nexus_boot.h
@@ -0,0 +1,110 @@
+/* nexus_boot.h - NEXUS boot-intent staging (the greapple-v2 contract)
+ *
+ * PS5GreenApple v2.1 turns the NEXUS hub into Stage A of the real boot flow:
+ * the hub writes /data/NEXUS/boot-select.json (the "boot intent"); the NEXUS
+ * Linux stage reads it (bootchain/kexec/nexus-boot-select.sh) and dispatches.
+ * The app itself never boots anything - it has no kernel access, and that
+ * stays true. See nexus-hub/greapple-v2/README.md (NEXUS-OS) for the spec
+ * and agents/state-machines.json SM-01 "Boot Intent Contract" for the
+ * machine this code implements.
+ *
+ * Schema (fixed, version 1 - three writers, one reader):
+ *   {"version":1,"target":"macos|windows|linux","flavor":"arch|ubuntu|...",
+ *    "staged_at":"YYYY-MM-DD HH:MM:SS","staged_by":"PS5GreenApple v2.1"}
+ * "flavor" is only valid (and only present) with target "linux".
+ */
+#ifndef NEXUS_BOOT_H
+#define NEXUS_BOOT_H
+#include <stddef.h>
+#include "common.h"
+
+#define NEXUS_SELECT_VERSION 1
+#define NEXUS_STAGED_BY      "PS5GreenApple v2.1"
+
+/* Root that both stages see. PS5: the shared console storage. Host: a local
+ * sandbox dir (env NEXUS_DATA_DIR overrides - used by the shot scripts and
+ * the unit tests; never honored on PS5). */
+const char *nexus_data_dir(void);
+
+/* Preset base = the boot USB root holding PS5-built kernels, exactly the
+ * table chainload-linux.sh consumes: <base>/linux/<flavor>/vmlinuz.
+ * PS5: /mnt/usb0 (the Linux-stage convention). Host: ./preset-fixture
+ * (env NEXUS_PRESET_BASE overrides), seeded by `make shots`. */
+const char *nexus_preset_base(void);
+
+/* ---- the 8-flavor roster. MUST stay in sync with
+ * bootchain/kexec/chainload-linux.sh (and the hub UI order in
+ * app_nexus.c: Ubuntu, Fedora, Arch, Debian, CachyOS, Nobara, Mint,
+ * Omarchy). One source of truth here so both apps agree. ---- */
+int         nexus_flavor_count(void);
+const char *nexus_flavor_slug(int idx);      /* 0..7 -> "ubuntu".. */
+int         nexus_flavor_known(const char *slug);
+int         nexus_flavor_preset_present(const char *flavor);
+            /* file_exists(<base>/linux/<flavor>/vmlinuz); the same artifact
+             * chainload-linux.sh die()s on when missing. */
+
+/* Write <data_dir>/NEXUS/boot-select.json atomically:
+ * write boot-select.json.tmp -> fflush -> fsync -> rename. A hub crash
+ * mid-write can therefore never leave a half-written intent (SM-01
+ * invariant 1), and the previous staged intent survives a failed stage.
+ * Returns 0 on success; on failure returns nonzero and fills errbuf. */
+int nexus_write_select(const char *data_dir,
+                       const char *target, const char *flavor,
+                       char *errbuf, size_t errlen);
+
+/* Parsed view of the currently staged intent (if any). */
+typedef struct NexusStaged {
+    int  present;                /* file exists */
+    int  version_ok;             /* version field == NEXUS_SELECT_VERSION */
+    int  target_ok;              /* macos | windows | linux */
+    int  flavor_ok;              /* non-linux: no flavor needed; linux: known */
+    char target[16];
+    char flavor[24];
+    char staged_at[32];          /* raw "YYYY-MM-DD HH:MM:SS" (UTC) */
+    long age_s;                  /* seconds since staged_at (F-C: surfaced) */
+} NexusStaged;
+
+/* Returns 0 when a staged intent was read (present==1), 1 when none is
+ * staged, <0 on unreadable/corrupt file (errbuf carries the reason).
+ * Never executes anything - read-only, like the status line should be. */
+int nexus_read_staged(const char *data_dir, NexusStaged *out,
+                      char *errbuf, size_t errlen);
+
+/* Tail of <data_dir>/NEXUS/boot-log.txt (written by the Linux-stage
+ * selector): the last 8 lines, '\n'-joined, so users can see WHY a boot
+ * did not happen. Returns 0 with content, nonzero when no log exists. */
+int nexus_read_last_status(const char *data_dir, char *out, size_t outlen);
+
+/* One-line hub summary: "target=linux flavor=omarchy age=34s" or
+ * "no intent staged". Used by the NEXUS status line and the terminal
+ * `nexus-status` builtin. */
+void nexus_status_summary(const char *data_dir, char *out, size_t outlen);
+
+/* ---- real volume enumeration (greapple-v2 Patch 3, SM-05) ----
+ * Shared lsblk walker: runs `lsblk -rno NAME,FSTYPE,LABEL,SIZE,MOUNTPOINT`
+ * through popen (Linux stage / host), decodes lsblk's \xNN escapes, and
+ * calls cb per row. Returns the row count (0 also when lsblk is absent).
+ * Each backend decides its own fallback: the dump/host backend has none,
+ * the PS5 SDL2 backend falls back to the bare-FW LIMITED roots. */
+int  nexus_lsblk_walk(bootcamp_volume_cb cb, void *user);
+
+/* Parse one raw lsblk line (positional fill: NAME always present, fields
+ * at the end may be missing, MOUNTPOINT is the trailing "/..." token).
+ * Returns 1 when a device row was extracted. Unit-tested. */
+int  nexus_parse_lsblk_line(const char *line, VolumeInfo *out);
+
+/* ---- guarded stage: the SM-01 writer path with the app status lines ----
+ * One implementation so the NEXUS hub and Boot Camp can never drift apart
+ * in what they tell the user. Fills:
+ *   status - exactly one of the spec lines:
+ *     "STAGED · will boot on next Linux-stage run"
+ *     "SIMULATED · this flavor has no PS5 kernel staged"
+ *     "STAGE FAILED · check /data writable"
+ *   detail - one honest follow-up line (chain note, or the write error).
+ * Returns 0 = intent staged, 1 = SIMULATED (nothing written), -1 = failed
+ * (nothing written; the previous intent survives untouched). */
+int nexus_stage_guarded(const char *target, const char *flavor,
+                        char *status, size_t statusn,
+                        char *detail, size_t detailn);
+
+#endif /* NEXUS_BOOT_H */
