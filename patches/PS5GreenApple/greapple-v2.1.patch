diff --git a/tests/test_nexus_boot.c b/tests/test_nexus_boot.c
new file mode 100644
index 0000000..3dd5692
--- /dev/null
+++ b/tests/test_nexus_boot.c
@@ -0,0 +1,206 @@
+/* tests/test_nexus_boot.c - host unit tests for the NEXUS boot-intent writer.
+ *
+ * Definition of done (nexus-hub/greapple-v2/README.md):
+ *   - valid write
+ *   - atomic rename survives a simulated crash (kill during write)
+ *   - unwritable dir -> error surfaced
+ * Plus the SM-01 contract edges: unknown target, linux-without-flavor,
+ * unknown flavor, previous intent survives a failed stage, reader
+ * round-trip, boot-log tail, schema-version mismatch.
+ *
+ * Build & run:  make test-nexus   (host only; exit 0 = all pass)
+ */
+#include "../src/nexus_boot.h"
+#include "../src/common.h"
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <errno.h>
+
+static int S_failed = 0;
+
+/* core.c's now_ms() reads the backend-provided virtual clock; the unit
+ * test runs headless with no backend, so it owns the symbol. */
+uint64_t g_vclock = 0;
+
+#define CHECK(cond, name)                                                     \
+    do {                                                                      \
+        if (cond) printf("PASS  %s\n", name);                                 \
+        else     { printf("FAIL  %s\n", name); S_failed = 1; }                \
+    } while (0)
+
+/* data_dir pointing at an existing REGULAR file: every mkdir/open inside
+ * fails with ENOTDIR - even when the tests run as root. Deterministic. */
+static void make_blocked_dir_fixture(const char *base, char *out, size_t n)
+{
+    psa_snprintf(out, n, "%s/blocked", base);
+    FILE *f = fopen(out, "w");
+    if (f) { fputs("this file blocks the data dir on purpose\n", f); fclose(f); }
+}
+
+int main(void)
+{
+    char base[] = "./nexus-test-tmp";
+    char dir[512], p[768], err[256];
+
+    system("rm -rf ./nexus-test-tmp");
+    ensure_dir(base);
+
+    /* ---- 1. valid write: linux + flavor ---- */
+    err[0] = 0;
+    int rc = nexus_write_select(base, "linux", "omarchy", err, sizeof(err));
+    CHECK(rc == 0 && err[0] == '\0', "valid write returns 0, no error");
+    psa_snprintf(p, sizeof(p), "%s/NEXUS/boot-select.json", base);
+    CHECK(file_exists(p), "boot-select.json exists");
+    psa_snprintf(p, sizeof(p), "%s/NEXUS/boot-select.json.tmp", base);
+    CHECK(!file_exists(p), "no .tmp leftover after rename");
+    {
+        psa_snprintf(p, sizeof(p), "%s/NEXUS/boot-select.json", base);
+        FILE *f = fopen(p, "r");
+        char json[1024] = "";
+        if (f) { size_t n = fread(json, 1, sizeof(json) - 1, f); json[n] = 0; fclose(f); }
+        CHECK(strstr(json, "\"version\":1") != NULL, "schema version present");
+        CHECK(strstr(json, "\"target\":\"linux\"") != NULL, "target written");
+        CHECK(strstr(json, "\"flavor\":\"omarchy\"") != NULL, "flavor written");
+        CHECK(strstr(json, "\"staged_at\":\"") != NULL, "staged_at written");
+        CHECK(strstr(json, "\"staged_by\":\"" NEXUS_STAGED_BY "\"") != NULL,
+              "staged_by written");
+    }
+
+    /* ---- 2. reader round-trip ---- */
+    {
+        NexusStaged st; char rerr[128];
+        rc = nexus_read_staged(base, &st, rerr, sizeof(rerr));
+        CHECK(rc == 0 && st.present, "reader sees staged intent");
+        CHECK(st.version_ok && st.target_ok && st.flavor_ok, "reader validates fields");
+        CHECK(!strcmp(st.target, "linux") && !strcmp(st.flavor, "omarchy"),
+              "reader round-trips target+flavor");
+        CHECK(st.age_s >= -1 && st.age_s < 3600, "age is sane");
+        char sum[128];
+        nexus_status_summary(base, sum, sizeof(sum));
+        CHECK(strstr(sum, "target=linux") != NULL && strstr(sum, "flavor=omarchy") != NULL,
+              "status summary line");
+    }
+
+    /* ---- 3. simulated crash: .tmp left behind, staged intent intact,
+     *        then a new stage succeeds and cleans up ---- */
+    {
+        psa_snprintf(dir, sizeof(dir), "%s/NEXUS/boot-select.json.tmp", base);
+        FILE *f = fopen(dir, "w");           /* the half-written tmp */
+        if (f) { fprintf(f, "{\"version\":1,\"target\":\"li"); fclose(f); }
+
+        NexusStaged st; char rerr[128];
+        nexus_read_staged(base, &st, rerr, sizeof(rerr));
+        CHECK(st.present && !strcmp(st.target, "linux"),
+              "crash mid-write: previous intent still readable (atomic rename)");
+
+        err[0] = 0;
+        rc = nexus_write_select(base, "macos", NULL, err, sizeof(err));
+        CHECK(rc == 0, "re-stage after simulated crash succeeds");
+        CHECK(!file_exists(dir), "re-stage removes the stale .tmp");
+        NexusStaged st2;
+        nexus_read_staged(base, &st2, rerr, sizeof(rerr));
+        CHECK(!strcmp(st2.target, "macos") && st2.flavor[0] == '\0',
+              "last-staged-wins: new intent replaced old (no flavor for macos)");
+    }
+
+    /* ---- 4. contract edges: writer rejects what the reader would die on ---- */
+    {
+        err[0] = 0;
+        rc = nexus_write_select(base, "plan9", NULL, err, sizeof(err));
+        CHECK(rc != 0 && strstr(err, "unknown target") != NULL, "unknown target rejected");
+
+        err[0] = 0;
+        rc = nexus_write_select(base, "linux", NULL, err, sizeof(err));
+        CHECK(rc != 0 && strstr(err, "needs a flavor") != NULL, "linux-without-flavor rejected");
+
+        err[0] = 0;
+        rc = nexus_write_select(base, "linux", "gentoo", err, sizeof(err));
+        CHECK(rc != 0 && strstr(err, "unknown flavor") != NULL, "unknown flavor rejected");
+
+        err[0] = 0;
+        rc = nexus_write_select(base, "macos", "arch", err, sizeof(err));
+        CHECK(rc != 0 && strstr(err, "flavor only valid") != NULL, "flavor on non-linux rejected");
+
+        NexusStaged st; char rerr[128];
+        nexus_read_staged(base, &st, rerr, sizeof(rerr));
+        CHECK(st.present && !strcmp(st.target, "macos"),
+              "rejected stages never touched the staged intent");
+    }
+
+    /* ---- 5. unwritable dir -> error surfaced ---- */
+    {
+        char blocked[512];
+        make_blocked_dir_fixture(base, blocked, sizeof(blocked));
+        err[0] = 0;
+        rc = nexus_write_select(blocked, "linux", "arch", err, sizeof(err));
+        CHECK(rc != 0 && err[0] != '\0', "unwritable dir returns error text");
+    }
+
+    /* ---- 6. boot-log tail ---- */
+    {
+        psa_snprintf(dir, sizeof(dir), "%s/NEXUS/boot-log.txt", base);
+        FILE *f = fopen(dir, "w");
+        for (int i = 1; i <= 12; i++)
+            fprintf(f, "2026-11-09 12:%02d:00 dispatch: line %d\n", i, i);
+        fclose(f);
+        char tail[1024];
+        rc = nexus_read_last_status(base, tail, sizeof(tail));
+        CHECK(rc == 0, "boot-log tail readable");
+        CHECK(strstr(tail, "line 12") != NULL && strstr(tail, "line 4") == NULL,
+              "tail keeps the last 8 lines only");
+    }
+
+    /* ---- 7. schema-version mismatch surfaced, not silently accepted ---- */
+    {
+        psa_snprintf(dir, sizeof(dir), "%s/NEXUS/boot-select.json", base);
+        FILE *f = fopen(dir, "w");
+        if (f) { fprintf(f, "{\"version\":2,\"target\":\"macos\",\"staged_at\":\"x\"}\n"); fclose(f); }
+        NexusStaged st; char rerr[128]; char sum[160];
+        rc = nexus_read_staged(base, &st, rerr, sizeof(rerr));
+        CHECK(rc == 0 && st.present && !st.version_ok, "future schema flagged version_ok=0");
+        nexus_status_summary(base, sum, sizeof(sum));
+        CHECK(strstr(sum, "SCHEMA MISMATCH") != NULL, "summary says SCHEMA MISMATCH (F-A)");
+    }
+
+    /* ---- 8. flavor preset table mirrors chainload-linux.sh ---- */
+    {
+        CHECK(nexus_flavor_count() == 8, "8 flavors (hub roster)");
+        CHECK(nexus_flavor_known("omarchy") && !nexus_flavor_known("gentoo"),
+              "flavor whitelist matches chain L");
+        /* isolation: point the preset base at an empty dir FIRST - the
+         * workspace may legitimately contain `make shots`'s fixture. */
+        setenv("NEXUS_PRESET_BASE", "./preset-fixture-test-empty", 1);
+        CHECK(!nexus_flavor_preset_present("omarchy"), "no preset before fixture");
+        system("mkdir -p ./preset-fixture-test/linux/omarchy && : > ./preset-fixture-test/linux/omarchy/vmlinuz");
+        setenv("NEXUS_PRESET_BASE", "./preset-fixture-test", 1);
+        CHECK(nexus_flavor_preset_present("omarchy"), "preset found at <base>/linux/<flavor>/vmlinuz");
+        CHECK(!nexus_flavor_preset_present("arch"), "missing preset reported for other flavor");
+        unsetenv("NEXUS_PRESET_BASE");
+    }
+
+    /* ---- 9. lsblk line parser (positional fill, missing fields) ---- */
+    {
+        VolumeInfo v;
+        CHECK(nexus_parse_lsblk_line("zram0   0B ", &v)
+              && !strcmp(v.name, "zram0") && !strcmp(v.size, "0B")
+              && !v.mounted && !v.internal_nvme,
+              "lsblk: name+size only");
+        CHECK(nexus_parse_lsblk_line("vda1 ext4 10G /", &v)
+              && !strcmp(v.fstype, "ext4") && !v.label[0]
+              && !strcmp(v.size, "10G") && v.mounted
+              && !strcmp(v.mountpoint, "/"),
+              "lsblk: fstype+size+mount, no label");
+        CHECK(nexus_parse_lsblk_line("sda1 ntfs Win\\x20SSD 931G /mnt/win", &v)
+              && !strcmp(v.fstype, "ntfs") && !strcmp(v.label, "Win SSD")
+              && !strcmp(v.mountpoint, "/mnt/win"),
+              "lsblk: \\x20 escape decoded in label");
+        CHECK(nexus_parse_lsblk_line("nvme0n1 894G", &v) && v.internal_nvme,
+              "lsblk: internal nvme flagged");
+        CHECK(!nexus_parse_lsblk_line("   ", &v), "lsblk: blank line skipped");
+    }
+
+    system("rm -rf ./nexus-test-tmp ./preset-fixture-test ./preset-fixture-test-empty");
+    printf(S_failed ? "\nUNIT: FAILURES ABOVE\n" : "\nUNIT: all nexus_boot tests passed\n");
+    return S_failed;
+}
