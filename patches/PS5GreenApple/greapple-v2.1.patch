+/* ---- greapple-v2 Patch 3 (SM-05 "Boot Camp Volume Row") ----
+ * Two runtime contexts, decided at runtime - no build-time fork:
+ *   1. under the ps5-linux-loader guest (or any desktop Linux) a shell
+ *      exists: the shared lsblk walker returns the real block devices;
+ *   2. bare FW userland has no shell: lsblk yields nothing, so fall back
+ *      to stat-probing the visible roots (/mnt/usb0, /mnt/usb1, /data)
+ *      and flag each row LIMITED - "no block info in FW userland".
+ * Internal NVMe is never probed here: upstream blocks it on purpose. */
+static void fw_root_row(const char *alias, const char *path,
+                        bootcamp_volume_cb cb, void *user)
+{
+    VolumeInfo v;
+    memset(&v, 0, sizeof(v));
+    psa_strcpy(v.name, sizeof(v.name), alias);
+    psa_strcpy(v.mountpoint, sizeof(v.mountpoint), path);
+    psa_strcpy(v.size, sizeof(v.size), "?");
+    v.limited = 1;
+    v.mounted = file_exists(path);
+    if (v.mounted && cb) cb(&v, user);
+}
+
+int backend_list_volumes(bootcamp_volume_cb cb, void *user)
+{
+    int n = nexus_lsblk_walk(cb, user);       /* context 1: a shell exists */
+    if (n > 0) return n;
+    fw_root_row("usb0", "/mnt/usb0", cb, user);   /* context 2: bare FW */
+    fw_root_row("usb1", "/mnt/usb1", cb, user);
+    fw_root_row("data", "/data",     cb, user);
+    return file_exists("/mnt/usb0") + file_exists("/mnt/usb1") + file_exists("/data");
+}
